# MarketLab standalone database. May point at the approved RedDirt Postgres host,
# but MarketLab owns only the `marketlab` PostgreSQL schema.
DATABASE_URL="postgresql://user:password@host:5432/database"
DIRECT_URL="postgresql://user:password@host:5432/database"

# MarketLab standalone Supabase Auth project. Do not reuse campaign auth variables.
NEXT_PUBLIC_MARKETLAB_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_MARKETLAB_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only AI integration.
MARKETLAB_OPENAI_API_KEY=""

# Market data provider selection. Build 1 ships with Alpaca support behind the provider contract.
MARKETLAB_MARKET_DATA_PROVIDER="alpaca"
MARKETLAB_ALPACA_API_KEY_ID=""
MARKETLAB_ALPACA_API_SECRET_KEY=""
# Supported Alpaca stock feeds include iex, sip (entitlement required), and delayed_sip.
MARKETLAB_ALPACA_FEED="iex"
