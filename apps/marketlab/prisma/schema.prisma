generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["marketlab"]
}

enum CompetitionStatus {
  DRAFT
  OPEN
  ACTIVE
  CLOSED
  ARCHIVED

  @@schema("marketlab")
}

enum CompetitionMemberRole {
  PLAYER
  ADMIN
  INSTRUCTOR

  @@schema("marketlab")
}

enum CashLedgerEntryType {
  OPENING_BALANCE
  TRADE_SETTLEMENT
  FEE
  DIVIDEND
  ADJUSTMENT
  REVERSAL

  @@schema("marketlab")
}

enum OrderSide {
  BUY
  SELL

  @@schema("marketlab")
}

enum OrderType {
  MARKET

  @@schema("marketlab")
}

enum OrderStatus {
  PENDING
  FILLED
  REJECTED
  CANCELLED

  @@schema("marketlab")
}

model MarketLabSystemRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("marketlab")
}

model Player {
  id           String   @id @default(cuid())
  authSubject  String   @unique
  email        String?  @unique
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  CompetitionMember[]
  portfolios   Portfolio[]

  @@schema("marketlab")
}

model Competition {
  id                   String            @id @default(cuid())
  slug                 String            @unique
  name                 String
  status               CompetitionStatus @default(DRAFT)
  startingCash         Decimal           @default(1000) @db.Decimal(18, 2)
  currencyCode         String            @default("USD")
  flatTradeFee         Decimal           @default(0) @db.Decimal(18, 4)
  slippageBps          Decimal           @default(0) @db.Decimal(10, 4)
  startsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  memberships          CompetitionMember[]
  portfolios           Portfolio[]

  @@index([status])
  @@schema("marketlab")
}

model CompetitionMember {
  id             String                @id @default(cuid())
  competitionId  String
  playerId       String
  role           CompetitionMemberRole @default(PLAYER)
  joinedAt       DateTime              @default(now())

  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player         Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([competitionId, playerId])
  @@index([playerId])
  @@schema("marketlab")
}

model Portfolio {
  id             String   @id @default(cuid())
  competitionId  String
  playerId       String
  currencyCode   String   @default("USD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  competition    Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player         Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  cashLedger     CashLedgerEntry[]
  orders         SimulatedOrder[]
  executions     SimulatedExecution[]
  positions      Position[]

  @@unique([competitionId, playerId])
  @@index([playerId])
  @@schema("marketlab")
}

model CashLedgerEntry {
  id             String              @id @default(cuid())
  portfolioId    String
  entryType      CashLedgerEntryType
  amount         Decimal             @db.Decimal(18, 2)
  currencyCode   String              @default("USD")
  memo           String?
  sourceType     String?
  sourceId       String?
  createdAt      DateTime            @default(now())

  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
  @@index([sourceType, sourceId])
  @@schema("marketlab")
}

model SimulatedOrder {
  id               String      @id @default(cuid())
  portfolioId      String
  idempotencyKey   String
  symbol           String
  side             OrderSide
  orderType        OrderType   @default(MARKET)
  status           OrderStatus @default(PENDING)
  quantity         Decimal     @db.Decimal(18, 8)
  requestedAt      DateTime    @default(now())
  completedAt      DateTime?
  rejectReason     String?

  portfolio        Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  execution        SimulatedExecution?

  @@unique([portfolioId, idempotencyKey])
  @@index([portfolioId, requestedAt])
  @@index([symbol, requestedAt])
  @@schema("marketlab")
}

model SimulatedExecution {
  id               String   @id @default(cuid())
  orderId          String   @unique
  portfolioId      String
  symbol           String
  side             OrderSide
  quantity         Decimal  @db.Decimal(18, 8)
  marketPrice      Decimal  @db.Decimal(18, 8)
  executionPrice   Decimal  @db.Decimal(18, 8)
  grossAmount      Decimal  @db.Decimal(18, 2)
  feeAmount        Decimal  @db.Decimal(18, 2)
  cashImpact       Decimal  @db.Decimal(18, 2)
  quoteTimestamp   DateTime
  provider         String
  feed             String?
  executedAt       DateTime @default(now())

  order             SimulatedOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  portfolio         Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, executedAt])
  @@index([symbol, executedAt])
  @@schema("marketlab")
}

model Position {
  id               String   @id @default(cuid())
  portfolioId      String
  symbol           String
  quantity         Decimal  @db.Decimal(18, 8)
  averageCost      Decimal  @db.Decimal(18, 8)
  realizedPnl      Decimal  @default(0) @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  portfolio        Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
  @@index([symbol])
  @@schema("marketlab")
}
