# Market-data configuration.
# Keep real credentials in Netlify environment variables, never in GitHub.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Phase 3B durable Market Memory.
# MUST point to a dedicated Trading Lab PostgreSQL target.
# Never fall back to the RedDirt campaign/SOS DATABASE_URL or DIRECT_URL.
