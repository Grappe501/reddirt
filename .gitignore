# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env / local secrets (OPENAI-KEY-OPS-1 — never commit)
.env
.env.local
.env*.local
.env.*.local
# optional Next-style files (often contain secrets if present)
.env.production
.env.development
# machine-local env backups (never commit — see docs/email-command-center-selective-staging-guide.md)
.env.backup*
.env.backup-*
.env.before-*
.env.broken-*

# typescript
*.tsbuildinfo

# ide / os
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
Thumbs.db

# local / deploy artifacts
.vercel
.netlify/.cache

# logs
*.log
stack-verify-last-run.txt
.pnpm-debug.log*

# local database backups (never commit dumps or exported migration tables)
backups/

# prisma local (if ever used)
prisma/*.db
prisma/*.db-journal

# campaign-owned binary uploads (local / self-hosted; use S3 + keys in production if you migrate)
data/owned-campaign-media
# Compliance import uploads and per-upload analyses can contain donor or bank data.
data/compliance/imports/goodchange/*
!data/compliance/imports/goodchange/.gitkeep
data/compliance/imports/bank/*
!data/compliance/imports/bank/.gitkeep
# Folder-ingest: keep uploads/ in repo but not dropped files
campaign-media/uploads/*
!campaign-media/uploads/.gitkeep
campaign-media/processed/
campaign-media/failed/
campaign-media/duplicate/
campaign-media/ingest.log
# USB phone imports (local only)
campaign-media/phone-import/

# AUTO-BUILD-2: generated nightly handoff markdown (keep .nightly-self-build/.gitkeep)
.nightly-self-build/nightly-self-build-*.md

# Supabase / Prisma introspection scratch (local only; do not commit)
tmp-supabase-introspection.schema.prisma
supabase-introspection.prisma
supabase-introspection.stderr.txt
supabase-to-local-prisma-diff.sql
supabase-to-local-prisma-diff.stderr.txt
