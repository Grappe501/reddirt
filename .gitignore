# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env / local secrets (OPENAI-KEY-OPS-1 — never commit)
.env
.env.local
.env*.local
.env.*.local
# optional Next-style files (often contain secrets if present)
.env.production
.env.development
# machine-local env backups (never commit — see docs/email-command-center-selective-staging-guide.md)
.env.backup*
.env.backup-*
.env.before-*
.env.broken-*

# typescript
*.tsbuildinfo

# ide / os
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
Thumbs.db

# local / deploy artifacts
.vercel
.netlify/.cache
# H: workspace toolchain cache/temp (parent folder — never commit)
../.local/

# logs
*.log
stack-verify-last-run.txt
.pnpm-debug.log*

# local database backups (never commit dumps or exported migration tables)
backups/

# prisma local (if ever used)
prisma/*.db
prisma/*.db-journal

# campaign-owned binary uploads (local / self-hosted; use S3 + keys in production if you migrate)
data/owned-campaign-media
# Local event drop folders — keep README/manifest; never commit raw video/audio/zips
data/local-ingest/**/*
!data/local-ingest/**/README.md
!data/local-ingest/**/event-manifest.json
!data/local-ingest/**/.gitkeep
# Hot Wash event media (binaries + media-index.json — may contain captions/PII)
data/campaign-events/media/**
!data/campaign-events/media/.gitkeep
