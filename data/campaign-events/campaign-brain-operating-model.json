{
  "version": 2,
  "modelId": "campaignBrain",
  "label": "Campaign Brain",
  "rule": "UNIFICATION_BEFORE_AUTOMATION",
  "operatingStack": [
    {
      "id": "mission",
      "label": "Mission",
      "description": "Kelly SOS statewide organizing mission — human-owned; not inferred by agents."
    },
    {
      "id": "goals",
      "label": "Goals",
      "description": "Registration, relational, turnout, and vote targets — LOCKED canon or SCENARIO_ESTIMATE only."
    },
    {
      "id": "canonicalData",
      "label": "Canonical data",
      "description": "CountyCampaignStats, ElectionCountyResult, governed exports — RedDirt Prisma + audit JSON."
    },
    {
      "id": "readinessGates",
      "label": "Readiness gates",
      "description": "strategySafeToGenerate, geography readiness, automation eligibility."
    },
    {
      "id": "countyIntelligence",
      "label": "County intelligence",
      "description": "countyIntelligenceCopilot — read-only readiness-gated analysis."
    },
    {
      "id": "countyInstitutionalMemory",
      "label": "County institutional memory",
      "description": "County memory timeline, event outcomes, regional influence, and cross-county relationship context (read-only)."
    }
  ],
  "agents": {
