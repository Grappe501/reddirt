/// Queue / scaffolding for generated renditions; workers create new `OwnedMediaAsset` children with `derivativeType` + `parentAssetId`.
model OwnedMediaDerivativeJob {
  id                   String                        @id @default(cuid())
  sourceAssetId        String
  sourceAsset          OwnedMediaAsset               @relation("DerivativeSourceJobs", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetDerivativeType OwnedMediaDerivativeType
  status               OwnedMediaDerivativeJobStatus @default(PLANNED)
  priority             Int                           @default(0)
  payloadJson          Json?
  lastError            String?                       @db.Text
  startedAt            DateTime?
  finishedAt           DateTime?
