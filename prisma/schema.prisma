  coalition
  media
  communications

  @@schema("public")
}

model CommunityWorkbench {
  id            String                           @id @default(cuid())
  slug          String                           @unique
  name          String
  kind          CommunityWorkbenchKind
  countySlug    String?
  citySlug      String?
  population    Int?
  tagline       String?
  kpiTemplate   String                           @default("default_city")
  active        Boolean                          @default(true)
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  leadership    CommunityWorkbenchLeadership[]
