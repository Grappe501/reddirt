  OUTBOUND

  @@schema("public")
}

enum CommsSendProvider {
  TWILIO
  SENDGRID
  GMAIL
  MANUAL
  SYSTEM

  @@schema("public")
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  OPENED
  CLICKED
  RECEIVED

  @@schema("public")
}

enum CommunicationActionType {
  SEND_SMS
  SEND_EMAIL
