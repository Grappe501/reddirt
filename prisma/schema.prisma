/// Canonical row for campaign-owned media (`OwnedMediaAsset` in app code; not renamed to `media_assets` in DB to avoid a breaking table rename).
model OwnedMediaAsset {
  id                      String                   @id @default(cuid())
  /// Storage object key. Local: `campaign-owned/...` · Supabase: `media/{year}/{month}/...` in the campaign bucket.
  storageKey              String                   @unique
  storageBackend          OwnedMediaStorageBackend @default(LOCAL_DISK)
  /// Optional public URL (Supabase public bucket URL, signed URL cache, or CDN). Local rows often use API route when null.
  publicUrl               String?
  /// Optional small preview in the same or sibling bucket path.
  thumbStorageKey         String?
  thumbPublicUrl          String?
  fileName                String
  fileSizeBytes           Int
  mimeType                String
  kind                    OwnedMediaKind
  role                    OwnedMediaRole           @default(OTHER)
  title                   String
  description             String?                  @db.Text
  /// Duration in seconds (video/audio) when known.
  durationSeconds         Int?
  width                   Int?
  height                  Int?
  /// EXIF/embedded “taken at” (device). Distinct from editorial `eventDate`.
  capturedAt              DateTime?
  eventDate               DateTime?
  /// GPS from EXIF when present (WGS84).
  gpsLat                  Float?
  gpsLng                  Float?
  geoSource               GeoMetadataSource        @default(NONE)
  /// 0–1 when inferred/reverse-mapped; null if unknown.
  geoConfidence           Float?
  /// True if county/city/geo should be confirmed before publishing to county pages.
  needsGeoReview          Boolean                  @default(false)
  countySlug              String?
  countyFips              String?
  /// Optional FK to `County` (filter chips); may lag `countySlug` until backfilled.
  countyId                String?
  county                  County?                  @relation(fields: [countyId], references: [id], onDelete: SetNull)
  city                    String?
  issueTags               String[]                 @default([])
  campaignPhase           String?
  contentSeries           String?
  speakerName             String?
  /// Raw EXIF / container / Nominatim audit tail (see `ingress` in JSON). AI or model suggestions use `enrichmentMetadata`, not this field.
  metadataJson            Json?
  sourceType              OwnedMediaSourceType     @default(DIRECT_UPLOAD)
  reviewStatus            OwnedMediaReviewStatus   @default(PENDING_REVIEW)
  isPublic                Boolean                  @default(false)
  /// For supporter-facing uploads later: explicit opt-in to campaign use.
  consentCampaignUse      Boolean?
  uploaderName            String?
  uploaderEmail           String?
  /// Staff-only operational notes (not necessarily public-facing).
  operatorNotes           String?                  @db.Text
  /// Draft social / press caption; distinct from structured annotation rows.
  captionDraft            String?                  @db.Text
  /// When EXIF `capturedAt` is wrong, override the “shot at” time for this asset.
  shootDateOverride       DateTime?
  /// Optional link to a scheduled campaign event (rally, canvass launch, etc.).
  linkedCampaignEventId   String?
  linkedCampaignEvent     CampaignEvent?           @relation("OwnedMediaCampaignEvent", fields: [linkedCampaignEventId], references: [id], onDelete: SetNull)
  /// Non-canonical: suggested tags, model hints, run timestamps. Never overwrites `OwnedMediaTranscript` text.
  enrichmentMetadata      Json?
  transcriptJobStatus     TranscriptionJobStatus   @default(NOT_REQUESTED)
  transcriptionLastError  String?                  @db.Text
  /// SHA-256 of file bytes; dedupes folder-ingest and future supporter uploads.
  ingestContentSha256     String?                  @unique
  /// Set by local folder watcher: original relative path (audit).
  localIngestRelativePath String?
  /// Label of the approved index root (env-configured) that produced this row — not a raw full path.
  indexSourceLabel        String?
  /// Filename as imported or captured (audit); `fileName` / `title` may follow campaign naming rules.
  originalFileName        String?
  /// Deterministic, human-readable campaign name (stems from `campaign-filename`); not a client filesystem path.
  canonicalFileName       String?
  /// Triage: 0–5 stars, null = not rated.
  rating                  Int?
  pickStatus              OwnedMediaPickStatus     @default(UNRATED)
  colorLabel              OwnedMediaColorLabel     @default(NONE)
  isFavorite              Boolean                  @default(false)
  /// Stack / burst group (shared id = same stack); originals and picks can share a stack id.
  stackGroupId            String?
  /// Direct parent in a derivative tree (e.g. web JPEG from camera original).
  parentAssetId           String?
  parentAsset             OwnedMediaAsset?         @relation("OwnedMediaDerivation", fields: [parentAssetId], references: [id], onDelete: SetNull)
  derivedChildren         OwnedMediaAsset[]        @relation("OwnedMediaDerivation")
  /// Top-most source asset in a lineage; null = this row is a root original.
  rootAssetId             String?
  rootAsset               OwnedMediaAsset?         @relation("OwnedMediaRoot", fields: [rootAssetId], references: [id], onDelete: SetNull)
  sameRootAssets          OwnedMediaAsset[]        @relation("OwnedMediaRoot")
  derivativeType          OwnedMediaDerivativeType @default(ORIGINAL)
  /// Governance: in addition to `approvedForSocial` (workbench) — press kit / website use.
  approvedForPress        Boolean                  @default(false)
  approvedForPublicSite   Boolean                  @default(false)
  /// Staff triage and review, distinct from public description.
  staffReviewNotes        String?                  @db.Text
  /// Idempotent import / hash collision notes.
  importDuplicateNote     String?                  @db.Text
  /// When staff marks media safe to reference from Social Workbench / public use (governance).
  approvedForSocial       Boolean                  @default(false)
  /// Optional bulk import session (folder / device ingest). Same as campaign “import batch” in UI copy.
  /// App/docs alias: `importBatchId` in API and integration notes = this FK to `MediaIngestBatch` (not a second table).
  mediaIngestBatchId      String?
  mediaIngestBatch        MediaIngestBatch?        @relation(fields: [mediaIngestBatchId], references: [id], onDelete: SetNull)
  /// Last Media Center / staff “reviewed at” (distinct from `reviewStatus` lifecycle).
  reviewedAt              DateTime?
  reviewedByUserId        String?
  reviewedBy              User?                    @relation("OwnedMediaReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  /// Short triage / handoff note for Media Center (separate from `staffReviewNotes` / `operatorNotes`).
  reviewNotes             String?                  @db.Text
  createdBy               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  transcripts           OwnedMediaTranscript[]
  quoteCandidates       OwnedMediaQuoteCandidate[]
  annotations           OwnedMediaAnnotation[]
  signupSheetDocuments  SignupSheetDocument[]
  socialContentLinks    SocialContentMediaRef[]
  collectionItems       OwnedMediaCollectionItem[]
  reviewLogs            OwnedMediaReviewLog[]
  derivativeJobsPlanned OwnedMediaDerivativeJob[]  @relation("DerivativeSourceJobs")

  @@index([countyId, capturedAt])
  @@index([approvedForSocial, kind])
  @@index([countySlug, eventDate])
  @@index([countySlug, capturedAt])
  @@index([city, capturedAt])
  @@index([capturedAt])
  @@index([eventDate])
  @@index([reviewStatus])
  @@index([transcriptJobStatus])
  @@index([isPublic, reviewStatus])
  @@index([sourceType, reviewStatus])
  @@index([kind, capturedAt])
  @@index([needsGeoReview])
  @@index([gpsLat, gpsLng])
  @@index([linkedCampaignEventId])
  @@index([mediaIngestBatchId, reviewStatus])
  @@index([stackGroupId])
  @@index([pickStatus, reviewStatus])
  @@index([colorLabel])
  @@index([rating])
  @@index([isFavorite])
  @@index([parentAssetId])
  @@index([rootAssetId])
  @@index([derivativeType])
  @@index([approvedForPress])
  @@index([approvedForPublicSite])
  @@index([reviewedAt])
  @@index([reviewedByUserId])
  @@index([countyId, pickStatus, capturedAt])
  @@schema("public")
}

