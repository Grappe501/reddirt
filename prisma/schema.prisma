  membersJson      String?
  notes            String?
  operatorInitials String?            @db.VarChar(3)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  events           CommunityWorkbenchEvent[]

  @@index([workbenchId])
  @@schema("public")
}

enum CommunityWorkbenchEventStatus {
  idea
  planned
  confirmed
  executed
  aar_complete
  cancelled

  @@schema("public")
}

model CommunityWorkbenchEvent {
  id                 String                        @id @default(cuid())
