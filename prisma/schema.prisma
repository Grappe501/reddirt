  APPEARANCE
  TRAINING
  MEETING
  CANVASS
  PHONE_BANK
  FUNDRAISER
  PRESS
  DEADLINE
  ORIENTATION
  /// Third-party fair, festival, or community gathering (often after promotion from ingest).
  FESTIVAL
  OTHER

  @@schema("public")
