model ExternalIngestRun {
  id                   String                  @id @default(cuid())
  source               ExternalIngestSource
  providerAccountEmail String?               @db.VarChar(320)
  staffUserId          String?
  staffUser            User?                   @relation("ExternalIngestStaffMailbox", fields: [staffUserId], references: [id], onDelete: SetNull)
  requestedByUserId    String?
  requestedBy          User?                   @relation("ExternalIngestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  status               ExternalIngestRunStatus @default(DRAFT)
  mode                 ExternalIngestRunMode
