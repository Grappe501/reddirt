model CommunicationPlan {
  id                        String                  @id @default(cuid())
  title                     String
  objective                 CommunicationObjective
  status                    CommunicationPlanStatus @default(DRAFT)
  /// Reuses the shared campaign task priority scale (single-tenant / campaign-local deployment).
  priority                  CampaignTaskPriority    @default(MEDIUM)
  summary                   String?                 @db.Text
  ownerUserId               String?
  ownerUser                 User?                   @relation("CommsPlanOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  requestedByUserId         String?
  requestedByUser           User?                   @relation("CommsPlanRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  /// Optional provenance: why this plan exists (e.g. `INTAKE`, `TASK`); see also FKs and `metadataJson`.
  sourceType                String?
  sourceWorkflowIntakeId    String?
  sourceWorkflowIntake      WorkflowIntake?         @relation("CommsPlanSourceIntake", fields: [sourceWorkflowIntakeId], references: [id], onDelete: SetNull)
  sourceCampaignTaskId      String?
  sourceCampaignTask        CampaignTask?           @relation("CommsPlanSourceTask", fields: [sourceCampaignTaskId], references: [id], onDelete: SetNull)
  sourceEventId             String?
  sourceEvent               CampaignEvent?          @relation("CommsPlanSourceEvent", fields: [sourceEventId], references: [id], onDelete: SetNull)
  sourceSocialContentItemId String?
  sourceSocialContentItem   SocialContentItem?      @relation("CommsPlanSourceSocial", fields: [sourceSocialContentItemId], references: [id], onDelete: SetNull)
  dueAt                     DateTime?
  scheduledAt               DateTime?
  approvedAt                DateTime?
  metadataJson              Json                    @default("{}")
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  drafts                    CommunicationDraft[]
  sends                     CommunicationSend[]
  mediaOutreachItems        MediaOutreachItem[]
  /// Campaign-local (message-plan) audience segments; CE-1+ engagement layer.
  commsPlanAudienceSegments CommsPlanAudienceSegment[]
  /// E-1: email workflow items referencing this plan.
  emailWorkflowItems        EmailWorkflowItem[]        @relation("EmailWorkflowItemPlan")

  @@index([status, updatedAt])
  @@index([objective, status])
  @@index([scheduledAt])
  @@index([ownerUserId])
  @@index([status, scheduledAt])
  @@index([sourceWorkflowIntakeId])
  @@index([sourceCampaignTaskId])
  @@index([sourceEventId])
  @@index([sourceSocialContentItemId])
  @@schema("public")
}

model CommunicationDraft {
  id                      String                       @id @default(cuid())
  communicationPlanId     String
  plan                    CommunicationPlan            @relation(fields: [communicationPlanId], references: [id], onDelete: Cascade)
  channel                 CommsWorkbenchChannel
  title                   String?
  subjectLine             String?                      @db.Text
  previewText             String?                      @db.Text
  bodyCopy                String                       @default("") @db.Text
  shortCopy               String?                      @db.Text
  /// Aligns with Social / Author learning dimensions where applicable.
  messageToneMode         SocialMessageToneMode?
  messageTacticMode       SocialMessageTacticMode?
  ctaType                 String?
  status                  CommunicationDraftStatus     @default(DRAFT)
  createdByUserId         String?
  createdByUser           User?                        @relation("CommsDraftCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId         String?
  updatedByUser           User?                        @relation("CommsDraftUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  isPrimary               Boolean                      @default(false)
  reviewRequestedAt       DateTime?
  reviewRequestedByUserId String?
  reviewRequestedByUser   User?                        @relation("CommsDraftReviewRequester", fields: [reviewRequestedByUserId], references: [id], onDelete: SetNull)
  reviewedAt              DateTime?
  reviewedByUserId        String?
  reviewedByUser          User?                        @relation("CommsDraftReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewDecision          CommunicationReviewDecision?
  reviewNotes             String?                      @db.Text
  metadataJson            Json                         @default("{}")
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  variants CommunicationVariant[]
  sends    CommunicationSend[]

  @@index([communicationPlanId])
  @@index([status])
  @@index([channel])
  @@index([isPrimary])
  @@index([messageToneMode])
  @@index([messageTacticMode])
  @@schema("public")
}

model CommunicationVariant {
  id                      String                       @id @default(cuid())
  communicationDraftId    String
  draft                   CommunicationDraft           @relation(fields: [communicationDraftId], references: [id], onDelete: Cascade)
  variantType             CommunicationVariantType     @default(OTHER)
  /// Opaque id or external segment key; no CRM engine integration in this packet.
  targetSegmentId         String?
  targetSegmentLabel      String?
  channelOverride         CommsWorkbenchChannel?
  subjectLineOverride     String?                      @db.Text
