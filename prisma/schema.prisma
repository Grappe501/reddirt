  @@schema("public")
}

/// Durable Campaign Event Fact Card row — calendar import + editable operations fields (CE-LEDGER-1).
model CampaignEventLedgerRecord {
  id                    String                              @id @default(cuid())
  /// Ledger month bucket, e.g. `2026-03`.
  period                String
  /// Stable upsert key: `normalized_calendar:{calendarItemId}`.
  sourceKey             String                              @unique
  calendarSourceId      String                              @unique
  googleEventId           String?                             @unique
  sourceCalendarName      String?
  createdFromSource       CampaignEventLedgerCreatedFrom    @default(NORMALIZED_CALENDAR)
  entrySource             CampaignEventLedgerCreatedFrom      @default(NORMALIZED_CALENDAR)
  originalTitle           String
  originalNotes           String?                             @db.Text
  originalLocation        String?                             @db.Text
  startAt                 DateTime
  endAt                   DateTime?
  allDay                  Boolean                             @default(false)
  eventStatus             CampaignEventLedgerEventStatus      @default(NEEDS_REVIEW)
  calendarStatus          CampaignEventLedgerCalendarStatus   @default(IMPORTED_ONLY)
  reviewStatus            CampaignEventLedgerReviewStatus     @default(NOT_STARTED)
  tentativeCalendarId     String?
  officialCalendarId      String?
  googleSyncStatus        CampaignEventLedgerGoogleSyncStatus @default(NOT_LINKED)
  googleLastSyncedAt      DateTime?
  googleEventUrl          String?
  /// Denormalized list-view fields (updated on fact-card save).
  displayCity             String?
  displayEventType        String?
  roundTripMiles          Decimal?                            @db.Decimal(10, 1)
  reimbursementAmount     Decimal?                            @db.Decimal(12, 2)
  factCard                Json
  createdAt               DateTime                            @default(now())
  updatedAt               DateTime                            @updatedAt

  @@index([period, startAt])
  @@index([eventStatus, startAt])
  @@index([googleSyncStatus])
  @@schema("public")
}

// --- Sprint 10: multi-campaign tenancy (foundation) ---

