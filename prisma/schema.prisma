  @@schema("public")
}

enum CampaignEventLedgerCalendarStatus {
  TENTATIVE_CALENDAR
  OFFICIAL_CALENDAR
  UNSYNCED
  IMPORTED_ONLY

  @@schema("public")
}

enum CampaignEventLedgerReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  NEEDS_INFO
  READY

  @@schema("public")
}

enum CampaignEventLedgerGoogleSyncStatus {
  NOT_LINKED
  PENDING
