  PREVIEWED
  RUNNING
  COMPLETED
  FAILED
  CANCELED

  @@schema("public")
}

enum ExternalIngestRunMode {
  PREVIEW
  IMPORT
  INCREMENTAL

  @@schema("public")
}

enum GmailMessageParticipantRole {
  FROM
  TO
  CC
  BCC
  REPLY_TO

  @@schema("public")
}

enum CommunicationIdentityReviewStatus {
  AUTO_LINKED
  NEEDS_REVIEW
  POSSIBLE_DUPLICATE
  SUPPRESSED
  IGNORED

  @@schema("public")
}

enum CommunicationIdentitySignalSource {
  GMAIL_MESSAGE
  GOOGLE_CONTACT
  GOOGLE_CALENDAR_EVENT
  FORM_INTAKE
  SENDGRID_EVENT
  MANUAL

  @@schema("public")
}

enum CommunicationMatchTargetType {
  EMAIL_CONTACT_PROFILE
  RELATIONAL_CONTACT
  VOTER_RECORD

  @@schema("public")
}

enum CommunicationMatchCandidateStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED

  @@schema("public")
}

enum GoogleContactSourceKind {
