/// Planning / future sync mapping for a contact row (no SendGrid API calls in this packet).
model SendGridContactMap {
  id                        String                    @id @default(cuid())
  emailContactProfileId     String?
  emailContactProfile       EmailContactProfile?      @relation(fields: [emailContactProfileId], references: [id], onDelete: SetNull)
  emailAudienceDefinitionId String?
  emailAudienceDefinition   EmailAudienceDefinition?  @relation(fields: [emailAudienceDefinitionId], references: [id], onDelete: SetNull)
  email                     String                    @db.VarChar(320)
  sendgridContactId         String?                   @db.VarChar(120)
  syncStatus                SendGridContactSyncStatus @default(NOT_SYNCED)
  lastSyncAt                DateTime?
  lastErrorSafe             String?                   @db.Text
  metadataJson              Json                      @default("{}")
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([email])
  @@index([syncStatus])
  @@index([emailContactProfileId])
  @@index([emailAudienceDefinitionId])
  @@schema("public")
}

/// One planning row per saved audience definition — list/segment ids are future sync targets only.
model SendGridAudienceMap {
  id                        String                     @id @default(cuid())
  emailAudienceDefinitionId String                     @unique
  emailAudienceDefinition   EmailAudienceDefinition    @relation(fields: [emailAudienceDefinitionId], references: [id], onDelete: Cascade)
  sendgridListId            String?                    @db.VarChar(120)
  sendgridSegmentId         String?                    @db.VarChar(120)
  syncStatus                SendGridAudienceSyncStatus @default(NOT_SYNCED)
  lastPreviewAt             DateTime?
  lastSyncAt                DateTime?
  metadataJson              Json                       @default("{}")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@schema("public")
}

/// Append-only suppression signals from webhooks / manual ops (governance before future sends).
model SendGridSuppression {
  id              String                  @id @default(cuid())
  email           String                  @db.VarChar(320)
  suppressionType SendGridSuppressionType
  sendgridEventId String?                 @db.VarChar(200)
  source          String                  @default("sendgrid_webhook") @db.VarChar(120)
  occurredAt      DateTime
  metadataJson    Json                    @default("{}")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([email])
  @@index([suppressionType, occurredAt])
  @@index([occurredAt])
  @@schema("public")
}

/// Sanitized SendGrid Event Webhook payloads (no secret-bearing fields).
model SendGridEvent {
  id                          String   @id @default(cuid())
  email                       String?  @db.VarChar(320)
  eventType                   String   @db.VarChar(80)
  sendgridEventId             String?  @unique @db.VarChar(200)
  sendgridMessageId           String?  @db.VarChar(240)
  sendgridMarketingCampaignId String?  @db.VarChar(120)
  emailAudienceDefinitionId   String?
  emailContactProfileId       String?
  occurredAt                  DateTime
  rawEventJson                Json     @default("{}")
  metadataJson                Json     @default("{}")
  createdAt                   DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([occurredAt])
  @@index([email])
  @@schema("public")
}

/// EMAIL-SENDGRID-CONTACT-SYNC-1.1 + EMAIL-SENDGRID-CONTACT-UPsert-EXECUTION-1.2 — operator-driven preview / approval; optional governed Marketing Contacts upsert (no email send from this model).
enum SendGridContactSyncRunStatus {
  PREVIEWED
  APPROVED
  SYNCED
  FAILED
  ARCHIVED

  @@schema("public")
}

model SendGridContactSyncRun {
  id                        String                       @id @default(cuid())
  audienceDefinitionId      String?
  audienceDefinition        EmailAudienceDefinition?     @relation(fields: [audienceDefinitionId], references: [id], onDelete: SetNull)
  status                    SendGridContactSyncRunStatus @default(PREVIEWED)
  candidateCount            Int                          @default(0)
  excludedSuppressedCount   Int                          @default(0)
  excludedMissingEmailCount Int                          @default(0)
  warningCount              Int                          @default(0)
  sendgridListId            String?                      @db.VarChar(120)
  sendgridSegmentId         String?                      @db.VarChar(120)
  previewJson               Json
  resultJson                Json                         @default("{}")
  createdByUserId           String?
  createdBy                 User?                        @relation("SendGridContactSyncRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUserId          String?
  approvedBy                User?                        @relation("SendGridContactSyncRunApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt                DateTime?
  syncedAt                  DateTime?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  emailSendExecutions       EmailSendExecution[]

  @@index([audienceDefinitionId, createdAt])
  @@index([status, createdAt])
  @@schema("public")
}

// --- EMAIL-SEND-EXECUTION-1.0 — governed SendGrid send execution (audit; no queue send; no automation). ---

enum EmailSendExecutionStatus {
  DRAFT
  PREFLIGHT_FAILED
  READY_FOR_TEST
  TEST_SENT
  READY_FOR_FINAL_APPROVAL
  FINAL_APPROVED
  SENDING
  SENT
  PARTIAL_FAILURE
  FAILED
  CANCELLED
  ARCHIVED

  @@schema("public")
}

enum EmailSendExecutionSendType {
  SENDGRID_TEST
  SENDGRID_BROADCAST
  GMAIL_ONE_TO_ONE_FUTURE

  @@schema("public")
}

enum EmailSendRecipientStatus {
  CANDIDATE
  EXCLUDED_SUPPRESSED
  EXCLUDED_MISSING_CONSENT
  READY
  SUBMITTED
  DELIVERED
  BOUNCED
  UNSUBSCRIBED
  SPAM_REPORTED
  FAILED

  @@schema("public")
}

enum EmailSendApprovalType {
  OPERATOR_REVIEW
  COMMS_REVIEW
  PRINCIPAL_REVIEW
  LEGAL_REVIEW
  FINANCE_REVIEW
  FINAL_SEND_APPROVAL

  @@schema("public")
}

enum EmailSendApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED

  @@schema("public")
}

model EmailSendExecution {
  id                        String                     @id @default(cuid())
  status                    EmailSendExecutionStatus   @default(DRAFT)
  sendType                  EmailSendExecutionSendType @default(SENDGRID_BROADCAST)
  messageStudioDraftId      String?
  messageStudioDraft        MessageStudioDraft?        @relation(fields: [messageStudioDraftId], references: [id], onDelete: SetNull)
  emailAudienceDefinitionId String?
  emailAudienceDefinition   EmailAudienceDefinition?   @relation(fields: [emailAudienceDefinitionId], references: [id], onDelete: SetNull)
  sendGridContactSyncRunId  String?
  sendGridContactSyncRun    SendGridContactSyncRun?    @relation(fields: [sendGridContactSyncRunId], references: [id], onDelete: SetNull)
  sendPacketJson            Json                       @default("{}")
  subject                   String                     @default("") @db.Text
  preheader                 String                     @default("") @db.Text
  body                      String                     @default("") @db.Text
  fromEmail                 String                     @default("") @db.VarChar(320)
  fromName                  String                     @default("") @db.VarChar(320)
  replyToEmail              String?                    @db.VarChar(320)
  testRecipientEmail        String?                    @db.VarChar(320)
  candidateRecipientCount   Int                        @default(0)
  suppressedRecipientCount  Int                        @default(0)
  finalRecipientCount       Int                        @default(0)
  preflightJson             Json                       @default("{}")
  approvalJson              Json                       @default("{}")
  providerResultJson        Json                       @default("{}")
  errorSafe                 String?                    @db.Text
  createdByUserId           String?
  createdBy                 User?                      @relation("EmailSendExecutionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  preflightByUserId         String?
  preflightBy               User?                      @relation("EmailSendExecutionPreflightBy", fields: [preflightByUserId], references: [id], onDelete: SetNull)
  approvedByUserId          String?
  approvedBy                User?                      @relation("EmailSendExecutionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  sentByUserId              String?
  sentBy                    User?                      @relation("EmailSendExecutionSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  preflightAt               DateTime?
  finalApprovedAt           DateTime?
  sentAt                    DateTime?
  archivedAt                DateTime?
  metadataJson              Json                       @default("{}")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  recipients EmailSendRecipient[]
  approvals  EmailSendApproval[]

  @@index([status, updatedAt])
  @@index([createdAt])
  @@index([messageStudioDraftId])
  @@index([emailAudienceDefinitionId])
  @@schema("public")
}

model EmailSendRecipient {
  id                    String                   @id @default(cuid())
  sendExecutionId       String
  sendExecution         EmailSendExecution       @relation(fields: [sendExecutionId], references: [id], onDelete: Cascade)
  email                 String                   @db.VarChar(320)
  emailContactProfileId String?
  emailContactProfile   EmailContactProfile?     @relation(fields: [emailContactProfileId], references: [id], onDelete: SetNull)
  status                EmailSendRecipientStatus @default(CANDIDATE)
  suppressionReason     String?                  @db.VarChar(500)
  providerMessageId     String?                  @db.VarChar(200)
  providerEventJson     Json?
  metadataJson          Json                     @default("{}")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([sendExecutionId, status])
  @@index([email])
  @@schema("public")
}

model EmailSendApproval {
  id               String                  @id @default(cuid())
  sendExecutionId  String
  sendExecution    EmailSendExecution      @relation(fields: [sendExecutionId], references: [id], onDelete: Cascade)
  approvalType     EmailSendApprovalType
  status           EmailSendApprovalStatus @default(PENDING)
  note             String                  @default("") @db.Text
  approvedByUserId String?
  approvedBy       User?                   @relation("EmailSendApprovalDecidedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([sendExecutionId, approvalType])
  @@schema("public")
}

// --- Contact engagement + segmentation (Comms workbench, campaign-local; CE-1) ---
// `CommunicationSend` is the message-level object; `CommunicationRecipient` is the per-recipient bridge.
// Distinct from Tier 2 `AudienceSegment` / `CommunicationCampaign` broadcast segments.

/// Lifecycle of a recipient row for a workbench send (aggregated/rolled up from events over time).
enum CommunicationRecipientStatus {
  PLANNED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  FAILED
  BOUNCED
  UNSUBSCRIBED
  CANCELED

  @@schema("public")
}

/// Normalized engagement and bridge events (provider + future web/landing; CE-3+ ingestion).
enum CommunicationRecipientEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  FAILED
  BOUNCED
  UNSUBSCRIBED
  OPTED_OUT_SMS
  WEB_VISIT
  FORM_SUBMITTED

  @@schema("public")
}

/// Best-known delivery state for a recipient row (recomputed from events + consent where applicable).
enum CommsDeliveryHealthStatus {
  HEALTHY
  SUPPRESSED
  UNSUBSCRIBED
  INVALID_EMAIL
  INVALID_PHONE
  HARD_BOUNCED
  SMS_OPT_OUT
  UNKNOWN

  @@schema("public")
}

enum CommsPlanAudienceSegmentType {
  STATIC
  DYNAMIC
  SYSTEM

  @@schema("public")
}

enum CommsPlanAudienceSegmentStatus {
  ACTIVE
  ARCHIVED

  @@schema("public")
}

enum CommsPlanAudienceSegmentMemberSource {
  MANUAL
  IMPORT
  DYNAMIC_SNAPSHOT
  API
  OTHER

  @@schema("public")
}

model CommunicationRecipient {
  id                        String                       @id @default(cuid())
  communicationSendId       String
  send                      CommunicationSend            @relation(fields: [communicationSendId], references: [id], onDelete: Cascade)
  /// Optional link to a message-plan audience segment (CE-6+); null when not segment-targeted.
  comsPlanAudienceSegmentId String?
  comsPlanAudienceSegment   CommsPlanAudienceSegment?    @relation(fields: [comsPlanAudienceSegmentId], references: [id], onDelete: SetNull)
  channel                   CommsWorkbenchChannel
  /// Normalized address used for this attempt (email, E.164 phone, or opaque id if stored that way).
  addressUsed               String
  /// Opaque contact key (external/CRM-scoped string). Use when no `User`/`VolunteerProfile`/thread row applies yet.
  crmContactKey             String?
  userId                    String?
  user                      User?                        @relation("CommunicationRecipientUser", fields: [userId], references: [id], onDelete: SetNull)
  volunteerProfileId        String?
  volunteerProfile          VolunteerProfile?            @relation(fields: [volunteerProfileId], references: [id], onDelete: SetNull)
  communicationThreadId     String?
  thread                    CommunicationThread?         @relation("WorkbenchRecipientThread", fields: [communicationThreadId], references: [id], onDelete: SetNull)
  /// Echo of send-level segment hint for traceability.
  targetSegmentId           String?
  targetSegmentLabel        String?
  status                    CommunicationRecipientStatus @default(PLANNED)
  providerRecipientId       String?
  deliveryHealthStatus      CommsDeliveryHealthStatus    @default(UNKNOWN)
  metadataJson              Json                         @default("{}")
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  events CommunicationRecipientEvent[]

  /// CE-3: one workbench target per send+channel+normalized address (no duplicate expansion rows).
  @@unique([communicationSendId, channel, addressUsed])
  @@index([communicationSendId])
  @@index([comsPlanAudienceSegmentId])
  @@index([userId])
  @@index([volunteerProfileId])
  @@index([communicationThreadId])
  @@index([status, updatedAt])
  @@index([crmContactKey])
  @@index([deliveryHealthStatus])
  @@index([targetSegmentId])
  @@schema("public")
}

model CommunicationRecipientEvent {
  id                       String                          @id @default(cuid())
  communicationRecipientId String
  recipient                CommunicationRecipient          @relation(fields: [communicationRecipientId], references: [id], onDelete: Cascade)
  eventType                CommunicationRecipientEventType
  occurredAt               DateTime
  providerEventId          String?
  providerName             String?
  linkUrl                  String?                         @db.Text
  linkLabel                String?
  metadataJson             Json                            @default("{}")
  createdAt                DateTime                        @default(now())

  @@index([communicationRecipientId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([providerEventId])
  @@schema("public")
}

/// Tracked link on a workbench send (click bridge; optional in CE-1, used by CE-3+ / CE-8).
model CommunicationLinkDefinition {
  id                  String            @id @default(cuid())
  communicationSendId String
  send                CommunicationSend @relation(fields: [communicationSendId], references: [id], onDelete: Cascade)
  label               String
  url                 String            @db.Text
  /// Stable id for click correlation (query param or provider token).
  trackingKey         String
  createdAt           DateTime          @default(now())

  @@unique([communicationSendId, trackingKey])
  @@index([communicationSendId])
  @@schema("public")
}

/// Reusable group within a single message plan (distinct from broadcast `AudienceSegment`).
model CommsPlanAudienceSegment {
  id                  String                         @id @default(cuid())
  communicationPlanId String
  plan                CommunicationPlan              @relation(fields: [communicationPlanId], references: [id], onDelete: Cascade)
  name                String
  description         String?                        @db.Text
  segmentType         CommsPlanAudienceSegmentType   @default(STATIC)
  status              CommsPlanAudienceSegmentStatus @default(ACTIVE)
  /// Dynamic rule payload (CE-4+); for STATIC segments may store hints or match keys.
  ruleDefinitionJson  Json                           @default("{}")
  isDynamic           Boolean                        @default(false)
  createdByUserId     String?
  createdBy           User?                          @relation("CommsPlanSegmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId     String?
  updatedBy           User?                          @relation("CommsPlanSegmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  members                 CommsPlanAudienceSegmentMember[]
  communicationRecipients CommunicationRecipient[]
  emailWorkflowItems      EmailWorkflowItem[]              @relation("EmailWorkflowItemSegment")

  @@index([communicationPlanId])
  @@index([status])
  @@index([segmentType])
  @@index([isDynamic])
  @@index([name])
  @@index([createdByUserId])
  @@schema("public")
}

model CommsPlanAudienceSegmentMember {
  id                        String                               @id @default(cuid())
  comsPlanAudienceSegmentId String
  segment                   CommsPlanAudienceSegment             @relation(fields: [comsPlanAudienceSegmentId], references: [id], onDelete: Cascade)
  /// At least one identity field should be set (enforced in application / later CHECK).
  userId                    String?
  user                      User?                                @relation("CommsPlanSegmentMemberSubject", fields: [userId], references: [id], onDelete: Cascade)
  volunteerProfileId        String?
  segmentVolunteerProfile   VolunteerProfile?                    @relation("CommsPlanSegmentMemberVolunteer", fields: [volunteerProfileId], references: [id], onDelete: Cascade)
  crmContactKey             String?
  sourceType                CommsPlanAudienceSegmentMemberSource @default(MANUAL)
  addedByUserId             String?
  addedBy                   User?                                @relation("CommsPlanSegmentMemberAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                             @default(now())

  @@unique([comsPlanAudienceSegmentId, userId])
  @@index([comsPlanAudienceSegmentId])
  @@index([userId])
  @@index([volunteerProfileId])
  @@index([crmContactKey])
  /// One membership row per segment per user when `userId` is set (NULL userId allowed for crm-only rows).
  @@schema("public")
}

model MediaOutreachItem {
  id                              String                   @id @default(cuid())
  type                            MediaOutreachItemType
  title                           String
  contactName                     String?
  outletName                      String?
  status                          MediaOutreachStatus      @default(NEW)
  /// Reuse conversation monitoring urgency scale for ops consistency.
  urgency                         ConversationUrgency?
  linkedCommunicationPlanId       String?
  linkedCommunicationPlan         CommunicationPlan?       @relation(fields: [linkedCommunicationPlanId], references: [id], onDelete: SetNull)
  linkedWorkflowIntakeId          String?
  linkedWorkflowIntake            WorkflowIntake?          @relation("MediaOutreachSourceIntake", fields: [linkedWorkflowIntakeId], references: [id], onDelete: SetNull)
  linkedConversationOpportunityId String?
  linkedConversationOpportunity   ConversationOpportunity? @relation("MediaOutreachSourceOpp", fields: [linkedConversationOpportunityId], references: [id], onDelete: SetNull)
  notes                           String?                  @db.Text
  metadataJson                    Json                     @default("{}")
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt

  @@index([status, updatedAt])
  @@index([type, status])
  @@index([linkedCommunicationPlanId])
  @@index([linkedWorkflowIntakeId])
  @@index([linkedConversationOpportunityId])
  @@index([updatedAt])
  @@schema("public")
}

/// OAuth-linked Google mailbox for 1:1 human email from the workbench (Gmail API). Not used for SendGrid broadcast.
model StaffGmailAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Workspace / Gmail “send as” address (usually same as `User.email`).
  sendAsEmail    String
  oauthJson      Json     @default("{}")
  /// Monitor/sync telemetry (versioned JSON); never stores message bodies or tokens — see `gmail-sync-state.ts`.
  gmailSyncState Json     @default("{}")
  isActive       Boolean  @default(true)
  lastError      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("public")
}

