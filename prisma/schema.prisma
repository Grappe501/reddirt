/// One row per SOS file import / snapshot used for diffs and county rollups.
model VoterFileSnapshot {
  id                 String                @id @default(cuid())
  createdAt          DateTime              @default(now())
  /// When the raw file was first received by our systems (optional)
  fileReceivedAt     DateTime?
  /// When the file was ingested into our system
  importedAt         DateTime              @default(now())
  /// "As of" date represented by the export (often file generation / voter roll pull date)
  fileAsOfDate       DateTime
  /// Prior snapshot this import was diffed against (if any)
  previousSnapshotId String?
  previousSnapshot   VoterFileSnapshot?    @relation("VoterFileSnapshotChain", fields: [previousSnapshotId], references: [id], onDelete: SetNull)
  nextSnapshots      VoterFileSnapshot[]   @relation("VoterFileSnapshotChain")
  sourceFilename     String?
  /// SHA-256 of raw file bytes for idempotency
  sourceFileHash     String?               @unique
  rowCountProcessed  Int?
  status             VoterFileIngestStatus @default(RECEIVED)
  errorMessage       String?               @db.Text
  /// Optional notes for operators (e.g. special election cut)
  operatorNotes      String?               @db.Text

  countyMetrics   CountyVoterMetrics[]
  firstSeenVoters VoterRecord[]         @relation("VoterFirstSeen")
  lastSeenVoters  VoterRecord[]         @relation("VoterLastSeen")
  droppedVoters   VoterRecord[]         @relation("VoterDropped")
  updatedVoters   VoterRecord[]         @relation("VoterUpdatedFrom")
  snapshotChanges VoterSnapshotChange[]

  @@index([fileAsOfDate])
  @@index([status, fileAsOfDate])
  @@schema("public")
}

/// Precomputed per-county rollups for a given voter file snapshot (field program + public county pages).
model CountyVoterMetrics {
  id                                    String                    @id @default(cuid())
  countyId                              String
  county                                County                    @relation(fields: [countyId], references: [id], onDelete: Cascade)
  /// Denormalized from `County.slug` for warehouse exports and public APIs
  countySlug                            String
  voterFileSnapshotId                   String
  /// Source snapshot for this rollup (alias semantically: “source snapshot”)
  snapshot                              VoterFileSnapshot         @relation(fields: [voterFileSnapshotId], references: [id], onDelete: Cascade)
  /// Denormalized: same as snapshot.fileAsOfDate for fast reads
  asOfDate                              DateTime
  /// Must match `getCampaignRegistrationBaselineUtc()` from server config when row is written
  registrationBaselineDate              DateTime
  /// Total active registrants in file for this county at asOfDate (nullable until ETL fills)
  totalRegisteredCount                  Int?
  newRegistrationsSinceBaseline         Int                       @default(0)
  newRegistrationsSincePreviousSnapshot Int                       @default(0)
  droppedSincePreviousSnapshot          Int                       @default(0)
  netChangeSincePreviousSnapshot        Int                       @default(0)
  countyGoal                            Int?
  /// 0–100; null if goal unknown
  progressPercent                       Float?
  computedAt                            DateTime                  @default(now())
  reviewStatus                          CountyContentReviewStatus @default(PENDING_REVIEW)

  @@unique([countyId, voterFileSnapshotId])
  @@index([countySlug, asOfDate])
  @@index([asOfDate])
  @@index([countyId, asOfDate])
  @@schema("public")
}

/// Canonical voter key from SOS file — used for per-import diffs and assistance tooling (not official SOS UI).
/// Production voter-warehouse physical mapping (e.g. legacy `ar02_voters`) is **blocked** pending explicit DBA review — do not add @@map here in automated packets.
model VoterRecord {
  id                    String             @id @default(cuid())
  /// **Canonical identifier:** opaque stable key from the SOS / vendor voter file (VRN / state id—map to your column).
  voterFileKey          String             @unique
  countyFips            String
  countyId              String
  county                County             @relation(fields: [countyId], references: [id], onDelete: Cascade)
  /// Denormalized public county slug (matches `County.slug`)
  countySlug            String
  city                  String?
  precinct              String?
  registrationDate      DateTime?
  firstSeenSnapshotId   String
  firstSeen             VoterFileSnapshot  @relation("VoterFirstSeen", fields: [firstSeenSnapshotId], references: [id], onDelete: Restrict)
  lastSeenSnapshotId    String
  lastSeen              VoterFileSnapshot  @relation("VoterLastSeen", fields: [lastSeenSnapshotId], references: [id], onDelete: Restrict)
  updatedFromSnapshotId String?
  updatedFrom           VoterFileSnapshot? @relation("VoterUpdatedFrom", fields: [updatedFromSnapshotId], references: [id], onDelete: SetNull)
  /// When the voter no longer appears in the most recent file we have processed
  droppedAtSnapshotId   String?
  droppedAt             VoterFileSnapshot? @relation("VoterDropped", fields: [droppedAtSnapshotId], references: [id], onDelete: SetNull)
  /// Civil date / moment we treat as “dropped off” the roll (denormalized for reporting)
  droppedOffAt          DateTime?
  /// Denormalized from latest import: present in last completed snapshot’s file
  inLatestCompletedFile Boolean            @default(true)
  /// Filled when voter file import includes name columns; enables signup-sheet and assist matching.
  firstName             String?            @db.Text
  lastName              String?            @db.Text
  /// 10-digit US phone digits only, when import provides a phone column.
  phone10               String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  snapshotChanges           VoterSnapshotChange[]
  userLinks                 User[]                       @relation("UserVoterLink")
  volunteerMatchCandidates  VolunteerMatchCandidate[]
  signupEntriesMatched      SignupSheetEntry[]           @relation("SignupEntryMatchedVoter")
  voterSignals              VoterSignal[]
  voterModelClassifications VoterModelClassification[]
  voterInteractions         VoterInteraction[]
  voterVotePlans            VoterVotePlan[]
  relationalContacts        RelationalContact[]
  communicationIdentities CommunicationIdentity[]
  /// Optional per-contest participation from vendor / import (not vote choice).
  electionParticipations    VoterElectionParticipation[]

  @@index([countyId, inLatestCompletedFile])
  @@index([countyId, lastName, firstName])
  @@index([phone10])
  @@index([countySlug])
  @@index([countyFips])
  @@index([registrationDate])
  @@schema("public")
}

/// Per-voter participation flags for specific elections (yes/no — not how they voted).
/// `contestKey` should match ingest / vendor labels, e.g. `2022_GENERAL`, `2020_PREFERENTIAL_PRIMARY`.
model VoterElectionParticipation {
  id                 String                       @id @default(cuid())
  voterRecordId      String
  voterRecord        VoterRecord                  @relation(fields: [voterRecordId], references: [id], onDelete: Cascade)
  contestKey         String
  participated       Boolean
  /// If the source lists which primary ballot was taken (D/R). Null = unknown or not a primary.
  primaryBallotParty String?
  provenance         VoterParticipationProvenance @default(VENDOR_VOTER_FILE)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([voterRecordId, contestKey])
  @@index([voterRecordId])
  @@index([contestKey, participated])
  @@index([contestKey, primaryBallotParty])
  @@schema("public")
}

/// Provenance row for a modeled influence signal (not a vote claim).
model VoterSignal {
  id                  String              @id @default(cuid())
  voterRecordId       String?
  voterRecord         VoterRecord?        @relation(fields: [voterRecordId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// REL-2: optional provenance link to a relational contact (manual / seam writes only).
  relationalContactId String?
  relationalContact   RelationalContact?  @relation(fields: [relationalContactId], references: [id], onDelete: SetNull)
  signalKind          VoterSignalKind
  signalSource        VoterSignalSource
  signalStrength      VoterSignalStrength
  signalDate          DateTime?
  confidence          ModelConfidence
  notes               String?             @db.Text
  metadataJson        Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([voterRecordId])
  @@index([userId])
  @@index([relationalContactId])
  @@index([signalKind])
  @@schema("public")
}

/// Current and historical tier assignments; `isCurrent` marks the active row per voter for read helpers.
model VoterModelClassification {
  id                 String              @id @default(cuid())
  voterRecordId      String
  voterRecord        VoterRecord         @relation(fields: [voterRecordId], references: [id], onDelete: Cascade)
  classification     VoterClassification
  confidence         ModelConfidence
  sourceSummary      String?             @db.Text
  modelVersion       String              @default("voter-model-v1")
  generatedBy        ModelGeneratedBy
  generatedAt        DateTime            @default(now())
  isCurrent          Boolean             @default(true)
  overriddenByUserId String?
  overriddenBy       User?               @relation("VoterClassificationOverride", fields: [overriddenByUserId], references: [id], onDelete: SetNull)
  overriddenAt       DateTime?
  overrideReason     String?             @db.Text
  metadataJson       Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([voterRecordId])
  @@index([voterRecordId, isCurrent])
  @@schema("public")
}

/// Human- or staff-logged touchpoint; does not auto-imply support unless `supportLevel` is set.
model VoterInteraction {
  id                          String                  @id @default(cuid())
  voterRecordId               String?
  voterRecord                 VoterRecord?            @relation(fields: [voterRecordId], references: [id], onDelete: Cascade)
  /// REL-2: optional link to a volunteer's relational contact (provenance; not auto-set).
  relationalContactId         String?
  relationalContact           RelationalContact?      @relation(fields: [relationalContactId], references: [id], onDelete: SetNull)
  contactedByUserId           String?
  contactedBy                 User?                   @relation("VoterInteractionContactedBy", fields: [contactedByUserId], references: [id], onDelete: SetNull)
  relatedVolunteerUserId      String?
  relatedVolunteer            User?                   @relation("VoterInteractionRelatedVolunteer", fields: [relatedVolunteerUserId], references: [id], onDelete: SetNull)
  interactionType             VoterInteractionType
  interactionChannel          VoterInteractionChannel
  interactionDate             DateTime                @default(now())
  supportLevel                VoterSupportLevel?
  registrationChecked         Boolean                 @default(false)
  registrationStatusAtContact String?
  wantsFollowUp               Boolean                 @default(false)
  followUpNotes               String?                 @db.Text
  votePlanStatus              VotePlanStatus?
  notes                       String?                 @db.Text
  metadataJson                Json?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  @@index([voterRecordId])
  @@index([relationalContactId])
  @@index([contactedByUserId])
  @@index([relatedVolunteerUserId])
  @@index([interactionDate])
  @@schema("public")
}

/// REL-2: durable relational organizing contact for a volunteer owner; optional voter roll match (reviewed).
model RelationalContact {
  id                    String                           @id @default(cuid())
  ownerUserId           String
  owner                 User                             @relation("RelationalContactOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  matchedVoterRecordId  String?
  matchedVoterRecord    VoterRecord?                     @relation(fields: [matchedVoterRecordId], references: [id], onDelete: SetNull)
  countyId              String?
  county                County?                          @relation(fields: [countyId], references: [id], onDelete: SetNull)
  fieldUnitId           String?
  fieldUnit             FieldUnit?                       @relation(fields: [fieldUnitId], references: [id], onDelete: SetNull)
  firstName             String?                          @db.Text
  lastName              String?                          @db.Text
  displayName           String
  phone                 String?
  email                 String?                          @db.Text
  relationshipType      RelationalRelationshipType
  relationshipCloseness RelationalRelationshipCloseness?
  matchStatus           RelationalMatchStatus            @default(UNMATCHED)
  matchConfidence       ModelConfidence?
  organizingStatus      RelationalOrganizingStatus       @default(IDENTIFIED)
  supportLevel          VoterSupportLevel?
  isCoreFive            Boolean                          @default(false)
  powerOfFiveSlot       Int?
  lastContactedAt       DateTime?
  nextFollowUpAt        DateTime?
  notes                 String?                          @db.Text
  metadataJson          Json?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  voterInteractions    VoterInteraction[]
  voterSignals         VoterSignal[]
  emailContactProfiles EmailContactProfile[]
  communicationIdentities CommunicationIdentity[]
  workflowIntakes      WorkflowIntake[]
  fieldEntries         ElectionPlanFieldEntry[]
  rosterPersons        VolunteerLeaderRosterPerson[]

  @@index([ownerUserId])
  @@index([matchedVoterRecordId])
  @@index([countyId])
  @@index([fieldUnitId])
  @@index([matchStatus, organizingStatus])
  @@schema("public")
}

/// One row per voter for vote-plan tracking (multiple rows allowed; consumers should prefer latest by `updatedAt`).
model VoterVotePlan {
  id                   String         @id @default(cuid())
  voterRecordId        String
  voterRecord          VoterRecord    @relation(fields: [voterRecordId], references: [id], onDelete: Cascade)
  createdByUserId      String?
  createdBy            User?          @relation("VoterVotePlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  planStatus           VotePlanStatus @default(NEEDS_PLAN)
  votingMethod         String?
  plannedVoteDate      DateTime?
  pollingPlaceNotes    String?        @db.Text
  transportationNeeded Boolean        @default(false)
  reminderNeeded       Boolean        @default(true)
  notes                String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([voterRecordId])
  @@schema("public")
}

/// Per-voter delta rows for a snapshot (audit + recompute). Heavy table at full state scale—archive old snapshots as needed.
model VoterSnapshotChange {
  id                  String                  @id @default(cuid())
  voterFileSnapshotId String
  snapshot            VoterFileSnapshot       @relation(fields: [voterFileSnapshotId], references: [id], onDelete: Cascade)
  voterRecordId       String?
  voterRecord         VoterRecord?            @relation(fields: [voterRecordId], references: [id], onDelete: SetNull)
  /// Always store the SOS key for traceability even if `voterRecordId` is null in edge cases
  voterFileKey        String
  changeType          VoterSnapshotChangeType
  countyId            String
  county              County                  @relation(fields: [countyId], references: [id], onDelete: Cascade)
  countySlug          String
  summaryJson         Json?
  createdAt           DateTime                @default(now())

  @@index([voterFileSnapshotId, changeType])
  @@index([countySlug, voterFileSnapshotId])
  @@index([voterFileKey])
  @@schema("public")
}

// --- Campaign operations: workbench, events, tasks, workflows, asks (Slice 1) ---

enum CampaignEventType {
