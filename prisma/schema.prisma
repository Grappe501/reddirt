  emailContactProfile     EmailContactProfile?     @relation(fields: [emailContactProfileId], references: [id], onDelete: SetNull)
  communicationIdentityId String?
  communicationIdentity CommunicationIdentity?   @relation(fields: [communicationIdentityId], references: [id], onDelete: SetNull)
  createdAt               DateTime                 @default(now())

  @@index([normalizedEmail])
  @@index([gmailMessageRecordId])
  @@schema("public")
}

model GoogleContactRecord {
  id                   String               @id @default(cuid())
  googleResourceName   String               @unique @db.VarChar(512)
  etag                 String?              @db.VarChar(180)
  displayName          String?              @db.VarChar(500)
  givenName            String?              @db.VarChar(200)
  familyName           String?              @db.VarChar(200)
  primaryEmail         String?              @db.VarChar(320)
  emailsJson           Json                 @default("[]")
  phonesJson           Json                 @default("[]")
  addressesJson        Json                 @default("[]")
  organizationsJson    Json                 @default("[]")
  biographiesJson      Json?
  membershipsJson      Json?
  sourceType           GoogleContactSourceKind @default(CONTACT)
  providerAccountEmail String?              @db.VarChar(320)
  ingestRunId          String?
  ingestRun            ExternalIngestRun?   @relation(fields: [ingestRunId], references: [id], onDelete: SetNull)
  communicationIdentityId String?
  communicationIdentity CommunicationIdentity? @relation(fields: [communicationIdentityId], references: [id], onDelete: SetNull)
  emailContactProfileId String?
  emailContactProfile   EmailContactProfile? @relation(fields: [emailContactProfileId], references: [id], onDelete: SetNull)
