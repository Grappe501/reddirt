  raceEthnicityJson        Json?
  /// Optional education breakdown (aggregate).
  educationJson            Json?
  /// BLS or ACS employment mix (aggregate).
  employmentJson           Json?
  /// County unemployment rate (BLS / ACS) when available.
  unemploymentRatePercent  Float?
  /// Top industry shares — JSON, aggregate.
  blsIndustryMixJson       Json?
  source                   PublicDemographicsSource  @default(CENSUS_ACS)
  sourceDetail             String?
  asOfYear                 Int?
  fetchedAt                DateTime?
  reviewStatus             CountyContentReviewStatus @default(PENDING_REVIEW)
  updatedAt                DateTime                  @updatedAt

  @@schema("public")
}

/// Aggregate registered-voter file snapshot for a county (not individual voters).
model CountyRegistrationSnapshot {
