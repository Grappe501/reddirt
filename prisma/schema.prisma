model GmailMessageRecord {
  id                    String   @id @default(cuid())
  googleMessageId       String   @db.VarChar(180)
  googleThreadId        String?  @db.VarChar(180)
  historyId             String?  @db.VarChar(64)
  internalDate          DateTime?
  sentAt                DateTime?
  subject               String?  @db.Text
  snippet               String?  @db.Text
  labelIdsJson          Json     @default("[]")
  fromText              String?  @db.Text
  toText                String?  @db.Text
  ccText                String?  @db.Text
  bccText               String?  @db.Text
  replyToText           String?  @db.Text
  bodyText              String?  @db.Text
  bodyHtml              String?  @db.Text
  bodyHash              String?  @db.VarChar(128)
  hasAttachments        Boolean  @default(false)
  attachmentCount       Int      @default(0)
  sizeEstimate          Int?
