{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "French Hill Vote Record",
  "type": "object",
  "required": [
    "congress",
    "rollCall",
    "date",
    "measure",
    "hillVote",
    "partyBreak",
    "trumpBreak",
    "partisanIntensity",
    "sources"
  ],
  "properties": {
    "congress": { "type": "integer" },
    "rollCall": { "type": "integer" },
    "date": { "type": "string", "format": "date" },
    "measure": { "type": "string" },
    "question": { "type": "string" },
    "issueArea": { "type": "string" },
    "hillVote": { "enum": ["Yea", "Nay", "Present", "Not Voting"] },

    "republicanYea": { "type": ["integer", "null"] },
    "republicanNay": { "type": ["integer", "null"] },
    "democraticYea": { "type": ["integer", "null"] },
    "democraticNay": { "type": ["integer", "null"] },
    "republicanYeaPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "republicanNayPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "democraticYeaPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "democraticNayPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },

    "partyMajorityPosition": { "enum": ["Yea", "Nay", "Split", "Unknown"] },
    "partyBreak": { "type": "boolean" },
    "gopAlignment": { "type": "boolean" },

    "partisanIntensity": { "enum": ["high", "medium", "low", "unscored"] },
    "partisanIntensityScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "highlyPartisan": { "type": "boolean" },
    "partisanRuleVersion": { "type": "string" },
    "partisanRuleExplanation": { "type": "string" },

    "trumpPosition": { "enum": ["Support", "Oppose", "Neutral", "Ambiguous", "No documented position"] },
    "trumpAlignment": { "type": "boolean" },
    "trumpBreak": { "type": "boolean" },
    "doubleBreak": { "type": "boolean" },
    "highlyPartisanGopAlignment": { "type": "boolean" },
    "highlyPartisanTrumpAlignment": { "type": "boolean" },
    "highlyPartisanDoubleAlignment": { "type": "boolean" },

    "trumpEvidenceSummary": { "type": "string" },
    "plainLanguageSummary": { "type": "string" },
    "classificationConfidence": { "enum": ["high", "medium", "low"] },
    "notes": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url", "sourceType"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "sourceType": { "enum": ["house", "congress", "official-trump", "archive", "news", "other"] },
          "primary": { "type": "boolean" }
        }
      }
    }
  }
}
