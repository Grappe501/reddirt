# =============================================================================
# Environment template — copy to `.env` (and optionally `.env.local` for overrides).
# Never commit real secrets. `.env` and `.env.local` are gitignored.
#
# Load order: `.env` → `.env.local` (later wins). Prisma CLI reads `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — required for Prisma, admin board, forms, ingest
# -----------------------------------------------------------------------------
# Local Docker default (see docker-compose.yml — host port 5433):
DATABASE_URL="postgresql://reddirt:reddirt@127.0.0.1:5433/reddirt"
# Required for Prisma: same as DATABASE_URL for local Docker; for the **Live RedDirt Supabase DB** (canonical hosted Postgres) use the **direct** or **session** string from that project’s Connect UI when DATABASE_URL is a transaction pooler (see docs/deployment.md).
DIRECT_URL="postgresql://reddirt:reddirt@127.0.0.1:5433/reddirt"
#
# Shadow / clone Postgres — use ONLY for `prisma migrate deploy`, diff, and proofs (never point at production).
# Example: second local database on the same Docker instance (create with `CREATE DATABASE reddirt_shadow;`):
# SHADOW_DATABASE_URL="postgresql://reddirt:reddirt@127.0.0.1:5433/reddirt_shadow"
# SHADOW_DIRECT_URL="postgresql://reddirt:reddirt@127.0.0.1:5433/reddirt_shadow"
# For proofs: set shell `DATABASE_URL`/`DIRECT_URL` from these values so Prisma never mutates the primary DB.
#
# Bring up DB + run migrations:  npm run stack:up
# Quick check (container must be running):  npm run db:ping
# Avoid `npx prisma db pull` for “is it up?” — it re-introspects the whole schema and can look hung.
#
# Production / hosted Postgres: use your provider’s connection string (SSL params as required).
#
# --- Prisma vs Supabase SSR (`SUPABASE-CANONICAL-DB-AND-ENV-GATE-1.0`) ---
# `DATABASE_URL` + `DIRECT_URL` = **only** what Prisma uses (see `prisma/schema.prisma`).
# `NEXT_PUBLIC_SUPABASE_*` (documented below under Supabase) = **separate** — `@supabase/ssr` Auth/session refresh only.
# Setting Supabase public keys does **not** migrate or verify the Postgres behind DATABASE_URL.

# -----------------------------------------------------------------------------
# ADMIN — content board at /admin (required in production)
# -----------------------------------------------------------------------------
ADMIN_SECRET=change-me-in-production

# Election Plan portal (/election-plan/*) — password gate for leadership & coalition review
# Leader workbench sign-in (/election-plan/operators/leaders/sign-in) uses VOLUNTEER_HUB_PASSWORD.
# Volunteer personal board (/volunteers/sign-in) uses VOLUNTEER_HUB_PASSWORD, else ADMIN_SECRET.
# Set all three to the same rollout password in Netlify for production. Never commit real values.
# ELECTION_PLAN_PASSWORD=
# VOLUNTEER_HUB_PASSWORD=
# Future: comma-separated leadership emails for email login (not active yet)
# ELECTION_PLAN_ADMIN_EMAILS=

# Candidate-only adversarial mirror (second gate on /admin/intelligence/kelly-mirror)
# Hidden hub link word: quorum — not shown in nav. Staff admin login alone does not unlock.
# KELLY_MIRROR_PASSPHRASE=

# -----------------------------------------------------------------------------
# Debate week — optional Netlify/client flag (redirects /admin/* to intelligence workbench)
# Set on production during debate prep: NEXT_PUBLIC_INTELLIGENCE_LAUNCH_MODE=opposition_debate
# Unset after debate to restore full Campaign OS sidebar.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_INTELLIGENCE_LAUNCH_MODE=opposition_debate

# -----------------------------------------------------------------------------
# Ask Kelly floating guide (public) + admin AI palette button — off unless explicitly enabled
# NEXT_PUBLIC_ASK_KELLY_UI_ENABLED=true

# -----------------------------------------------------------------------------
# ElevenLabs — optional: “Read this aloud” on /admin/ask-kelly (server route only)
# Keys are never exposed to the client; set both for TTS, or leave unset (UI shows calm “unavailable”).
# Local: add to .env or .env.local. Production: set in Netlify → Environment variables, then redeploy.
# npm run set:elevenlabs — interactive save to .env.local (never commit that file)
# -----------------------------------------------------------------------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# -----------------------------------------------------------------------------
# OPENAI — server-only (optional for static browsing; required for ingest + RAG search + intake + Email queue AI analysis)
# Interactive ingest: npm run ingest:interactive
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Campaign guide (/api/assistant) — optional public-facing links for tools
# -----------------------------------------------------------------------------
# Newsletter signup URL surfaced by get_public_contact_info (e.g. Mailchimp/ActionKit). Not a secret.
# CAMPAIGN_NEWSLETTER_SIGNUP_URL=https://example.com/newsletter
# Dedicated press inbox (defaults to general campaign email in prompts if unset)
# CAMPAIGN_PRESS_EMAIL=press@example.com

# -----------------------------------------------------------------------------
# PUBLIC — NEXT_PUBLIC_* is embedded in client bundles. No secrets here.
# -----------------------------------------------------------------------------
# Canonical URL for Open Graph / metadata (no trailing slash)
# Netlify launch site — use the bare subdomain (no www); Netlify TLS does not cover www.*.netlify.app:
# NEXT_PUBLIC_SITE_URL=https://kgrappe.netlify.app

# Donation — overrides GoodChange default from KellyGrappe.com
# NEXT_PUBLIC_DONATE_EXTERNAL_URL=https://goodchange.app/donate/...

# County coordination hub (sister app — separate Netlify deploy; Pope-first portal)
# NEXT_PUBLIC_COUNTY_WORKBENCH_URL=https://your-county-workbench.netlify.app

# Legacy public site (volunteer/join + cross-links)
# NEXT_PUBLIC_LEGACY_SITE_URL=https://www.kellygrappe.com
# Optional. Defaults to on-site volunteer form: /get-involved#volunteer
# NEXT_PUBLIC_JOIN_CAMPAIGN_URL=https://www.example.com/volunteer
# NEXT_PUBLIC_VOLUNTEER_SIGNUP_URL=/get-involved#volunteer
#
# Native volunteer form on this site (/volunteer + /api/forms). When true, primary CTAs stay on-site; legacy URL kept as fallback.
# NEXT_PUBLIC_USE_NATIVE_VOLUNTEER_FORM=true
#
# Temporary operations inbox routing (server-only; comma-separated lists):
# OPS_NOTIFICATION_EMAIL_TO=ops@example.com,backup@example.com
# OPS_NOTIFICATION_EMAIL_BCC=
#
# Volunteer onboarding (/volunteer) — absolute URL to the **live** Squarespace form until relaunch.
# Overrides default `${NEXT_PUBLIC_CAMPAIGN_WEBSITE_URL or kellygrappe.com}/get-involved#volunteer`.
# NEXT_PUBLIC_VOLUNTEER_SIGNUP_EXTERNAL=https://www.kellygrappe.com/get-involved#volunteer

# Public campaign site root for src/lib/campaign-links.ts (donate/contact/get-involved composition).
# NEXT_PUBLIC_CAMPAIGN_WEBSITE_URL=https://www.kellygrappe.com
# NEXT_PUBLIC_CONTACT_EMAIL=kelly@kellygrappe.com

# -----------------------------------------------------------------------------
# /from-the-road + footer — public social hub (NEXT_PUBLIC_* only; no secrets)
# Same keys power the footer icons and the channel grid on /from-the-road.
# -----------------------------------------------------------------------------
# Substack / notebook (footer “Substack” icon uses this too):
# NEXT_PUBLIC_CAMPAIGN_BLOG_URL=https://kellygrappesos.substack.com
#
# Official channel URLs:
# NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://www.facebook.com/Kelly-Grappe-SOS
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/KellyGrappeSOS/
# NEXT_PUBLIC_SOCIAL_X_URL=https://x.com/kellygrappesos
# NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=https://www.youtube.com/@kellygrappesos
# NEXT_PUBLIC_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@kellygrappesos
#
# Optional live embeds on /from-the-road (official iframes only):
# NEXT_PUBLIC_FTR_FACEBOOK_PAGE_URL=   # Page plugin href; defaults to NEXT_PUBLIC_SOCIAL_FACEBOOK_URL
# NEXT_PUBLIC_FTR_TIKTOK_VIDEO_IDS=7123456789012345678,7123456789012345679
# NEXT_PUBLIC_FTR_YOUTUBE_UPLOADS_PLAYLIST_ID=UUxxxxxxxx   # YouTube Studio → Uploads playlist id (often starts with UU)
# NEXT_PUBLIC_FTR_INSTAGRAM_EMBED_SHORTCODES=AbCdEfGhIjK,xyz_12a   # Shortcodes from https://www.instagram.com/p/SHORTCODE/

# --- /about — two public video blocks (order matches src/config + about page) ---
#
# Talk Business & Politics (interview above the press card). `src` resolution: `src/config/talk-business-media.ts`
#  (1) NEXT_PUBLIC_TALK_BUSINESS_IFRAME_SRC  (2) ..._KELLY_YOUTUBE_VIDEO_ID  (3) NEXT_PUBLIC_FEATURE_VIDEO_EMBED_URL
#  (4) featured Inbound from HomepageConfig in DB (no key). Title: NEXT_PUBLIC_TALK_BUSINESS_IFRAME_TITLE
# NEXT_PUBLIC_TALK_BUSINESS_IFRAME_SRC=https://www.youtube.com/embed/xxxxxxxxxxx
# NEXT_PUBLIC_TALK_BUSINESS_IFRAME_TITLE=Kelly Grappe — Talk Business & Politics
# NEXT_PUBLIC_TALK_BUSINESS_KELLY_YOUTUBE_VIDEO_ID=
# NEXT_PUBLIC_FEATURE_VIDEO_EMBED_URL=https://www.youtube.com/embed/VIDEO_ID
#
# Forevermost / Heifer USA (above “The land & the work”). Resolution: `src/app/(site)/about/page.tsx`
#  (1) NEXT_PUBLIC_FOREVERMOST_HEIFER_INBOUND_ID  (2) ..._YOUTUBE_VIDEO_ID  (3) ..._IFRAME_TITLE (optional)
# If (1) and (2) are unset, the site uses the public Heifer video id baked into `about/page.tsx` (override with env to swap video).
# NEXT_PUBLIC_FOREVERMOST_HEIFER_INBOUND_ID=
# NEXT_PUBLIC_FOREVERMOST_HEIFER_YOUTUBE_VIDEO_ID=
# NEXT_PUBLIC_FOREVERMOST_HEIFER_IFRAME_TITLE=

# Official Arkansas voter registration lookup (VoterView / SOS). County pages and voter CTAs link here — no substitute.
# NEXT_PUBLIC_AR_VOTER_LOOKUP_URL=https://www.voterview.ar-nova.org/voterview
#
# Voter center UI: `handoff` (default) = native page + new tab to official tool. `campaign_assist_only` = emphasize campaign file help.
# NEXT_PUBLIC_VOTER_LOOKUP_UI_MODE=handoff

# Campaign registration metrics baseline (YYYY-MM-DD or full ISO). Central source: `src/config/campaign-registration-baseline.ts`
# CAMPAIGN_REGISTRATION_BASELINE=2025-11-25
# NEXT_PUBLIC_CAMPAIGN_REGISTRATION_BASELINE=2025-11-25

# “Paid for by” link target (defaults to NEXT_PUBLIC_SITE_URL). e.g. main campaign / RedDirt public site.
# NEXT_PUBLIC_COMMITTEE_SITE_URL=https://www.kellygrappe.com

# Optional homepage media
# NEXT_PUBLIC_HERO_VIDEO_URL=/media/hero-loop.mp4
# (NEXT_PUBLIC_FEATURE_VIDEO_EMBED_URL is documented above with Talk Business — same key.)

# -----------------------------------------------------------------------------
# FEEDS & SOCIAL — server-only; used by admin / orchestrator sync (optional)
# -----------------------------------------------------------------------------
# SUBSTACK_FEED_URL=https://yourhandle.substack.com/feed
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# YOUTUBE_CHANNEL_ID=
# YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# CAMPAIGN-OWNED MEDIA — local disk by default (`data/owned-campaign-media` under project root)
# -----------------------------------------------------------------------------
# Override absolute root for uploads (optional; defaults to ./data/owned-campaign-media)
# OWNED_MEDIA_DATA_ROOT=H:/SOSWebsite/RedDirt/data/owned-campaign-media
# Max upload size in bytes (default 2GiB; hard cap 4GiB; must stay <= serverActions body limit in next.config.ts)
# OWNED_MEDIA_MAX_BYTES=2147483648
# Reverse geocoding: OpenStreetMap Nominatim (1 req/s politeness; set 0 to disable network on ingest)
# OWNED_MEDIA_NOMINATIM=1
# OWNED_MEDIA_NOMINATIM_UA=MyCampaign/1.0 (contact: you@example.com)

# -----------------------------------------------------------------------------
# Supabase — required for `npm run ingest:watch` (folder → Storage + `OwnedMediaAsset`)
# Create a public (or use signed-URL) bucket matching SUPABASE_CAMPAIGN_MEDIA_BUCKET.
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY= (server/ingest only — never in NEXT_PUBLIC)
# Optional bucket name (default: campaign-media)
# SUPABASE_CAMPAIGN_MEDIA_BUCKET=campaign-media
# Watch folder: ./campaign-media/uploads (override)
# CAMPAIGN_MEDIA_ROOT=H:/SOSWebsite/RedDirt/campaign-media
# CAMPAIGN_MEDIA_WATCH_DIR=H:/SOSWebsite/RedDirt/campaign-media/uploads
# On start, scan existing files in uploads (set 0 to only watch new adds)
# CAMPAIGN_MEDIA_INGEST_SCAN_ON_START=1
#
# Public Supabase client (`@supabase/ssr` — `src/utils/supabase/*`, middleware session refresh). Omit both to skip Supabase in middleware.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # anon / publishable key from Supabase dashboard (never service_role)

# -----------------------------------------------------------------------------
# Google Calendar (Campaign HQ) — OAuth for `CalendarSource`; optional public site URL for callback
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=https://your-domain.com/api/calendar/google/callback
# Webhook for push sync (must be HTTPS in production): same origin + /api/calendar/google/webhook
# Cron: GET /api/calendar/google/cron-sync?key=... (incremental ingest + watch renewal)
# CALENDAR_CRON_SECRET=
# Mark the campaign Google calendar `CalendarSource` as isPublicFacing in DB (seed/admin), complete OAuth
# on /admin/workbench/calendar, then set true so new events from that calendar go live without a draft step:
# GOOGLE_CALENDAR_AUTO_PUBLISH_PUBLIC_FACING=true
# GET /api/cron/comms-broadcasts?key=... (broadcast campaign batches)
# COMMS_BROADCAST_CRON_SECRET=

# -----------------------------------------------------------------------------
# Staff Gmail (Command Center / workbench human send) — OAuth names only
# Preflight (DB + gmailSyncState migration + env presence, no secret values): npm run email:command-center:preflight
# Uses Gmail/Calendar client fallbacks: GOOGLE_GMAIL_CLIENT_ID or GOOGLE_CLIENT_ID or GOOGLE_CALENDAR_CLIENT_ID (+ matching *_SECRET)
# GOOGLE_GMAIL_REDIRECT_URI=https://your-domain.com/api/gmail/oauth/callback
# NEXT_PUBLIC_SITE_URL builds default redirect when GOOGLE_GMAIL_REDIRECT_URI is unset
# GMAIL_TOKEN_ENCRYPTION_KEY=   # required for NEW connects — AES-GCM seal at rest (do not commit real value)
# GMAIL_OAUTH_STATE_SECRET=     # optional; falls back to ADMIN_SECRET for signed OAuth state
# GOOGLE_PUBSUB_TOPIC=          # Gmail users.watch — full topic resource name projects/.../topics/...
# GMAIL_WATCH_LABEL_IDS=        # optional; comma-separated label ids (default INBOX)
# GMAIL_WATCH_RENEWAL_DAYS=     # optional; renewal interval hint 1–7 (default 1) — Google max watch lifetime ~7d
# GMAIL_WATCH_RENEWAL_EXECUTE=  # scripts only: must be "1" with `tsx scripts/gmail-watch-renewal-preview.ts --execute` to call users.watch
# GMAIL_PUBSUB_VERIFICATION_TOKEN=   # required for POST /api/gmail/pubsub — paired header x-gmail-pubsub-token (no values in docs)
# GOOGLE_PUBSUB_VERIFICATION_TOKEN= # alias for the same push verification secret
# GMAIL_OAUTH_INCLUDE_SEND_FOR_WORKBENCH=  # optional; when "true", OAuth requests gmail.send for workbench composer (default: metadata-only)
# ADMIN_ACTOR_USER_EMAIL=       # User.email for staff Gmail row resolution / OAuth actor

# Community fairs/festivals ingest → Prisma `ArkansasFestivalIngest` → /from-the-road feed
# GET /api/cron/festivals-ingest?key=...  |  GET /api/cron/festivals-coverage?key=... (AI weekend plan)
# FESTIVAL_INGEST_CRON_SECRET=   # falls back to CALENDAR_CRON_SECRET if unset
# FESTIVAL_INGEST_SEED_JSON=      # optional dev: JSON array of { name, startAt, endAt, sourceUrl, city?, countyId? }

# Earned media / press monitor (RSS-first; respects robots.txt)
# GET /api/cron/media-monitor?key=...&incremental=1  (optional &full=1 for all registry sources with feeds)
# MEDIA_MONITOR_CRON_SECRET=   # falls back to CALENDAR_CRON_SECRET if unset
# MEDIA_MONITOR_USE_OPENAI=1    # optional: refine uncertain items (uses OPENAI_API_KEY)

# -----------------------------------------------------------------------------
# Email / SMS (workbench, webhooks) — set as needed
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_FROM_NAME=
# Signed Event Webhook verification (PEM public key from SendGrid) — required in production for POST /api/sendgrid/events
# SENDGRID_WEBHOOK_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# Alias of the same PEM (names only; never commit real values):
# SENDGRID_WEBHOOK_PUBLIC_KEY=
# Optional future Marketing Campaigns / ASM wiring (not executed in EMAIL-SENDGRID-FOUNDATION-1.0)
# SENDGRID_UNSUBSCRIBE_GROUP_ID=
# SENDGRID_DEFAULT_LIST_ID=
# SENDGRID_SANDBOX_MODE=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Compliance April26 (local check images + bank CSV — not committed)
# -----------------------------------------------------------------------------
# COMPLIANCE_APRIL26_DIR=H:\SOSWebsite\Compliance\April26
# OPENAI_API_KEY=   # Required for vision extract on /admin/compliance/checks/sos-entry

